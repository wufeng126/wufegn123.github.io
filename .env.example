# 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值

# ============================================
# 应用公网地址（钉钉通知跳转必需）
# ============================================
# 用于把通知里的相对路径（如 /construction-logs?tab=daily-reports）拼成钉钉可点击的绝对 URL。
# 必须配置为部署环境的公网域名（例如 https://your-app.com），否则钉钉消息里的"处理入口"无法跳转。
# NEXT_PUBLIC_APP_URL=https://your-app.com

# ============================================
# JWT 认证密钥（必需）
# ============================================
# 至少 32 位的随机字符串，用于签发和验证 JWT Token
# 生成方式：openssl rand -base64 32 或访问 https://generate-secret.vercel.app/32
JWT_SECRET=your-secret-key-at-least-32-characters-long

# ============================================
# Supabase 数据库配置（必需）
# ============================================
COZE_SUPABASE_URL=https://your-project.supabase.co
COZE_SUPABASE_ANON_KEY=your-anon-key-here
COZE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# 钉钉企业内部应用配置（可选，用于钉钉免登）
# ============================================
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret
DINGTALK_AGENT_ID=your-dingtalk-agent-id
DINGTALK_CORP_ID=your-dingtalk-corp-id

# 钉钉回调配置（可选，用于事件订阅）
DINGTALK_CALLBACK_TOKEN=your-callback-token
DINGTALK_CALLBACK_AES_KEY=your-callback-aes-key

# ============================================
# 天气服务配置（可选）
# ============================================
# 默认使用中央气象台免费接口（国内直连，无需 Key，内置常用城市代码表）。
# 如需支持任意城市名 / 更稳定，可配置和风天气 Key（免费申请：https://dev.qweather.com）
# QWEATHER_API_KEY=your-qweather-api-key
# QWEATHER_API_HOST=https://devapi.qweather.com

# ============================================
# 对象存储配置（可选，用于文件上传）
# ============================================

# 方案 A：使用阿里云 OSS（推荐生产环境）
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=your-aliyun-access-key-id
OSS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_REGION=cn-beijing

# 方案 B：使用 Coze 平台内置存储（开发环境默认）
# COZE_BUCKET_ENDPOINT_URL=
# COZE_BUCKET_NAME=

# ============================================
# AI 服务配置（可选，用于 AI 劳务助手）
# ============================================
COZE_AI_API_KEY=your-ai-api-key
COZE_AI_API_ENDPOINT=https://your-ai-endpoint.com

# ============================================
# 钉钉 Webhook 机器人（可选，用于消息推送）
# ============================================
DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=your-token
DINGTALK_WEBHOOK_SECRET=your-webhook-secret
# 待办提醒/通知检查定时任务密钥（阿里云 FC 定时调用时携带 x-cron-secret）
DINGTALK_TODO_DIGEST_CRON_SECRET=your-cron-secret

# ============================================
# 安全与任务密钥（代码实际读取，务必配置）
# ============================================
# 初始管理员初始化密钥（首次部署用，生产建议部署后移除）
INIT_SECRET=your-init-secret
# 超管角色标识/ID（默认 super_admin / 不启用 roleId 判定）
SUPER_ADMIN_ROLE=super_admin
# AI 业务数据同步定时任务密钥（外部 cron 携带 x-cron-secret 调用 /api/ai/knowledge/sync）
AI_SYNC_CRON_SECRET=your-ai-sync-cron-secret
# WPS 花名册同步回调密钥
WPS_WORKER_SYNC_TOKEN=your-wps-sync-token

# ============================================
# 以下为代码实际读取但早期示例缺失的变量（A8 修复补齐）
# ============================================

# 数据库直连串（可选，用于自动执行建表迁移；Supabase 项目可在 Dashboard → Settings → Database 获取）
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# 超管角色ID（可选，仅当需要按 role_id 判定超管时配置；不配置则只按角色名判定）
# SUPER_ADMIN_ROLE_ID=1

# 开发预览模式开关（仅 NODE_ENV=development 且非 PROD 环境生效，切勿在生产开启）
# ENABLE_AUTH_BYPASS=false
# 未映射路由默认放行开关（仅开发调试用）
# UNMAPPED_ROUTE_ACCESS=allow

# 对象存储回退桶名（OSS 未配置时使用 Supabase Storage 的桶名，默认 app-files）
# SUPABASE_STORAGE_BUCKET=app-files

# AI 业务数据同步间隔（小时，惰性自动同步用，默认 24）
# AI_SYNC_INTERVAL_HOURS=24

# 施工日志项目日报定时任务密钥（外部 cron 携带 x-cron-secret 调用生成接口）
# CONSTRUCTION_DAILY_REPORT_CRON_SECRET=your-cron-secret
# 钉钉通讯录同步定时任务密钥
# DINGTALK_CONTACTS_SYNC_CRON_SECRET=your-cron-secret

# WPS 表格开放平台配置（可选，用于 WPS 花名册同步）
# WPS_APP_ID=your-wps-app-id
# WPS_APP_SECRET=your-wps-app-secret
# WPS_DOCUMENT_URL=https://kdocs.cn/l/xxxx
# WPS_SYNC_TOKEN=your-wps-sync-token（与 WPS_WORKER_SYNC_TOKEN 二选一，兼容旧名）

# 初始化密钥别名（init/permissions 路由读取，兼容 INIT_SECRET）
# INIT_SECRET_KEY=your-init-secret
